{
    "name": "tomvondracek/bolt-request-analytics",
    "description": "Cookieless, server-side visitor statistics for Bolt CMS 6, built only from the HTTP request: no JavaScript, no identifiers, no raw request storage.",
    "type": "bolt-extension",
    "license": "MIT",
    "keywords": ["bolt", "bolt-extension", "analytics", "statistics", "privacy", "cookieless"],
    "authors": [
        {
            "name": "Tomáš Vondráček",
            "email": "tomasvondrac@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "symfony/cache": "^6.4 || ^7.0",
        "symfony/lock": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.30",
        "symfony/polyfill-php84": "^1.43.0"
    },
    "require-dev": {
        "bolt/core": "^6.1.10",
        "phpstan/extension-installer": "1.4.3",
        "phpstan/phpstan": "2.3.4",
        "phpstan/phpstan-deprecation-rules": "2.0.5",
        "phpstan/phpstan-phpunit": "2.1.1",
        "phpstan/phpstan-strict-rules": "2.1.0",
        "phpunit/phpunit": "^11.5.58",
        "rector/rector": "2.8.3",
        "symplify/easy-coding-standard": "^13.3.23"
    },
    "conflict": {
        "bolt/core": "<6.1 || >=7.0"
    },
    "suggest": {
        "ext-apcu": "Keeps the throttle of logged failures in memory instead of in files"
    },
    "autoload": {
        "psr-4": {
            "TomVondracek\\RequestAnalytics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TomVondracek\\RequestAnalytics\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.2.x-dev"
        },
        "entrypoint": "TomVondracek\\RequestAnalytics\\Extension"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false,
            "drupol/composer-packages": false,
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        }
    }
}
