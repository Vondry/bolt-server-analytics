<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory="var/cache/phpunit"
         executionOrder="random"
         failOnWarning="true"
         failOnRisky="true"
         failOnNotice="true"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         beStrictAboutOutputDuringTests="true">
    <!--
        `vendor/bin/phpunit` runs both suites; CI runs them one after the other.
        security: malicious input (XSS, Twig, PHP, SQL, CRLF, ...) through
        everything a request or a parameter reaches, see tests/Security/.
    -->
    <testsuites>
        <testsuite name="unit">
            <directory>tests</directory>
            <exclude>tests/Security</exclude>
        </testsuite>
        <testsuite name="security">
            <directory>tests/Security</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
