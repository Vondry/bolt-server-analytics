{#
    What visitors looked for and did not find, side by side:

    - Broken links: missing pages with where the links to them are, and what
      to do: fix a link of this site, redirect one of another site; typed or
      bookmarked addresses can only be redirected.
    - Site search: the terms searched for, most first.

    Below the threshold of privacy only a count is shown. Follows the trend
    card through its `ra:range` event, like the other cards.
#}
{% set domain = 'request_analytics' %}
{% import '@request-analytics/skeleton/_macros.html.twig' as skeleton %}
{% import '@request-analytics/page/_insights.html.twig' as insightsUi %}
<div class="ra-gaps" data-ra-locale="{{ (app.request.locale ?? '')|replace({'_': '-'}) }}" id="ra-gaps" data-config="{{ {
    brokenLinksUrl: trend.brokenLinksUrl,
    searchesUrl: trend.searchesUrl,
}|json_encode }}" data-i18n="{{ {
    fix: 'A link on your site: fix it.'|trans({}, domain),
    redirect: 'A link on another site: add a redirect.'|trans({}, domain),
    typed: 'Typed or bookmarked'|trans({}, domain),
    otherSites: 'Other sites'|trans({}, domain),
    morePages: 'and %count% more pages'|trans({}, domain),
    homepage: 'Homepage'|trans({}, domain),
    noBroken: 'No broken links in this period.'|trans({}, domain),
    noSearches: 'No searches in this period.'|trans({}, domain),
    hiddenPages: '%count% more with fewer than %k% requests.'|trans({}, domain),
    hiddenTerms: '%count% more terms with fewer than %k% searches.'|trans({}, domain),
    redacted: 'Hidden: it contained personal data'|trans({}, domain),
    pageOf: 'Page %page% of %pages%'|trans({}, domain),
    failed: 'The statistics could not be loaded.'|trans({}, domain),
    compared: 'Compared with: %value%'|trans({}, domain),
    new: 'new'|trans({}, domain),
}|json_encode }}" data-threshold="{{ threshold }}">
    {# Broken links #}
    <div class="card mb-4" data-ra-gap="broken" aria-busy="true" id="ra-broken-links">
        <div class="card-header"><i class="fas fa-unlink"></i> &nbsp; {{ 'Broken links'|trans({}, domain) }}{{ insightsUi.badge(insights, 'broken-links') }}</div>
        <div class="card-body">
            {{ insightsUi.strip(insights, 'broken-links') }}
            <div class="table-responsive">
                <table class="table table-sm ra-gaps__table">
                    <thead><tr>
                        <th scope="col">{{ 'Missing page'|trans({}, domain) }}</th>
                        <th scope="col" class="ra-gaps__count">{{ 'Requests'|trans({}, domain) }}</th>
                        <th scope="col" class="ra-gaps__change" data-ra-change-head>{{ 'Change'|trans({}, domain) }}</th>
                        <th scope="col">{{ 'Where the link is'|trans({}, domain) }}</th>
                    </tr></thead>
                    <tbody data-ra-rows>{{ skeleton.table(4, 4) }}</tbody>
                </table>
            </div>
            <p class="text-muted small mb-2" data-ra-hidden hidden></p>
            <nav class="ra-gaps__paging" data-ra-paging hidden>
                <button type="button" class="btn btn-sm btn-light" data-ra-page="-1" aria-label="{{ 'Previous page'|trans({}, domain) }}">&lsaquo;</button>
                <span class="text-muted small" data-ra-page-label></span>
                <button type="button" class="btn btn-sm btn-light" data-ra-page="1" aria-label="{{ 'Next page'|trans({}, domain) }}">&rsaquo;</button>
            </nav>
            <details class="ra-help">
                <summary>{{ 'How is this filled?'|trans({}, domain) }}</summary>
                <p>{{ 'Every request of a visitor for a page that does not exist (404), with the page that linked to it. Bots are not counted.'|trans({}, domain) }}</p>
            </details>
        </div>
    </div>

    {# Site search #}
    <div class="card mb-4" data-ra-gap="search" aria-busy="true" id="ra-site-search">
        <div class="card-header"><i class="fas fa-search"></i> &nbsp; {{ 'Site search'|trans({}, domain) }}{{ insightsUi.badge(insights, 'search') }}</div>
        <div class="card-body">
            {{ insightsUi.strip(insights, 'search') }}
            <div class="table-responsive">
                <table class="table table-sm ra-gaps__table">
                    <thead><tr>
                        <th scope="col">{{ 'Search term'|trans({}, domain) }}</th>
                        <th scope="col" class="ra-gaps__count">{{ 'Searches'|trans({}, domain) }}</th>
                        <th scope="col" class="ra-gaps__change" data-ra-change-head>{{ 'Change'|trans({}, domain) }}</th>
                    </tr></thead>
                    <tbody data-ra-rows>{{ skeleton.table(4, 3) }}</tbody>
                </table>
            </div>
            <p class="text-muted small mb-2" data-ra-hidden hidden></p>
            <nav class="ra-gaps__paging" data-ra-paging hidden>
                <button type="button" class="btn btn-sm btn-light" data-ra-page="-1" aria-label="{{ 'Previous page'|trans({}, domain) }}">&lsaquo;</button>
                <span class="text-muted small" data-ra-page-label></span>
                <button type="button" class="btn btn-sm btn-light" data-ra-page="1" aria-label="{{ 'Next page'|trans({}, domain) }}">&rsaquo;</button>
            </nav>
            <details class="ra-help" data-ra-help>
                <summary>{{ 'How is this filled?'|trans({}, domain) }}</summary>
                <p>{{ 'A search is counted when the address carries its term in one of the search_params of the config: %params%. Terms are stored without e-mail addresses, phone numbers and long numbers.'|trans({'%params%': searchParams|join(', ') ?: '—'}, domain) }}</p>
            </details>
        </div>
    </div>
</div>

<style{% if nonce.style %} nonce="{{ nonce.style }}"{% endif %}>
    .ra-gaps { display: grid; grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr)); gap: 0 1.5rem; --ra-bar: var(--bs-primary, #0d6efd); }
    .ra-gaps .card { min-width: 0; }
    .ra-gaps__table td { vertical-align: top; }
    .ra-gaps__path { font-family: var(--bs-font-monospace, monospace); font-size: .85rem; word-break: break-all; }
    .ra-gaps__count { width: 7rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .ra-gaps__meter { display: inline-block; vertical-align: middle; height: .6rem; margin-right: .4rem; border-radius: 0 2px 2px 0; background: var(--ra-bar); }
    .ra-gaps__change { width: 5.5rem; text-align: right; white-space: nowrap; font-size: .85rem; }
    .ra-gaps__where { list-style: none; margin: 0; padding: 0; font-size: .8rem; }
    .ra-gaps__where li { overflow: hidden; text-overflow: ellipsis; }
    .ra-gaps__action { display: block; font-weight: 600; font-size: .75rem; }
    .ra-gaps__action.is-fix { color: var(--bs-danger, #dc3545); }
    .ra-gaps__muted { opacity: .65; }
    .ra-gaps__paging { display: flex; gap: .5rem; align-items: center; justify-content: center; margin-bottom: .5rem; }
</style>

<script{% if nonce.script %} nonce="{{ nonce.script }}"{% endif %}>
(function () {
    'use strict';

    var root = document.getElementById('ra-gaps');
    if (!root || root.dataset.raReady) { return; }
    root.dataset.raReady = '1';

    var config = JSON.parse(root.dataset.config);
    var i18n = JSON.parse(root.dataset.i18n);
    var threshold = root.dataset.threshold;
    // The language of the backend, as the texts are translated; <html lang> is the user's saved one.
    var locale = root.dataset.raLocale || document.documentElement.lang || undefined;
    var range = null;

    function number(value) { return Number(value).toLocaleString(locale); }

    function dateLabel(iso) { return new Date(iso + 'T00:00:00').toLocaleDateString(locale, { day: 'numeric', month: 'short', year: 'numeric' }); }

    function element(tag, className, text) {
        var node = document.createElement(tag);
        if (className) { node.className = className; }
        if (text !== undefined) { node.textContent = text; }
        return node;
    }

    function countCell(value, max) {
        var cell = element('td', 'ra-gaps__count');
        var meter = element('span', 'ra-gaps__meter');
        meter.style.width = (max ? Math.max(2, value / max * 4) : 0) + 'rem';
        cell.append(meter, document.createTextNode(number(value)));
        return cell;
    }

    // Up is bad for missing pages, neither for searches: more searches is interest.
    function changeCell(current, previous, better) {
        var result = window.raChange ? window.raChange(current, previous, better, i18n) : { text: '', className: '' };
        return element('td', 'ra-gaps__change ' + result.className, result.text);
    }

    function whereList(row) {
        var list = element('ul', 'ra-gaps__where');
        if (row.internal.length) {
            list.appendChild(element('li', 'ra-gaps__action is-fix', i18n.fix));
            // The pages with the most requests; a link in a template can be on hundreds.
            row.internal.slice(0, 5).forEach(function (page) {
                var item = element('li');
                var link = element('a', '', (page.title || (page.page === '/' ? i18n.homepage : page.page)) + ' · ' + number(page.hits));
                // Only a path of this site: never `//host` or `/\host`, which browsers take for another site.
                if (window.raSitePath(page.page)) { link.href = page.page; }
                link.target = '_blank';
                link.rel = 'noopener';
                link.title = page.page;
                item.appendChild(link);
                list.appendChild(item);
            });
            if (row.internal.length > 5) {
                list.appendChild(element('li', 'ra-gaps__muted', i18n.morePages.replace('%count%', number(row.internal.length - 5))));
            }
        }
        if (row.external.length) {
            list.appendChild(element('li', 'ra-gaps__action', i18n.redirect));
            row.external.forEach(function (site) {
                list.appendChild(element('li', '', (site.host === '(other)' ? i18n.otherSites : site.host) + ' · ' + number(site.hits)));
            });
        }
        if (row.typed) {
            list.appendChild(element('li', 'ra-gaps__muted', i18n.typed + ' · ' + number(row.typed)));
        }
        return list;
    }

    function card(name, url, columns, renderRow, emptyText, hiddenText, better) {
        var box = root.querySelector('[data-ra-gap="' + name + '"]');
        var $ = function (selector) { return box.querySelector(selector); };
        var state = { page: 1 }, request = 0;

        function render(data) {
            var body = $('[data-ra-rows]');
            body.textContent = '';
            var compared = !!data.previousFrom;
            var head = $('[data-ra-change-head]');
            head.hidden = !compared;
            head.title = compared ? i18n.compared.replace('%value%', dateLabel(data.previousFrom) + ' – ' + dateLabel(data.previousTo)) : '';
            if (!data.rows.length) {
                var cell = element('td', 'text-muted', emptyText);
                cell.colSpan = columns;
                body.appendChild(element('tr')).appendChild(cell);
            }
            data.rows.forEach(function (row) { body.appendChild(renderRow(row, data, compared)); });
            var hidden = $('[data-ra-hidden]');
            hidden.hidden = !data.hidden;
            hidden.textContent = hiddenText.replace('%count%', number(data.hidden)).replace('%k%', number(threshold));
            $('[data-ra-paging]').hidden = data.pages < 2;
            $('[data-ra-page-label]').textContent = i18n.pageOf.replace('%page%', number(data.page)).replace('%pages%', number(data.pages));
            $('[data-ra-page="-1"]').disabled = data.page <= 1;
            $('[data-ra-page="1"]').disabled = data.page >= data.pages;
            var help = $('[data-ra-help]');
            if (help && !data.rows.length && !data.hidden) { help.open = true; }
            state.page = data.page;
        }

        function load() {
            if (!range) { return; }
            var current = ++request;
            var params = Object.assign({ from: range.from, to: range.to, page: String(state.page) }, window.raComparison ? window.raComparison(range) : {});
            window.raLoading(box, window.raFetch(url + '?' + new URLSearchParams(params))
                .then(function (response) {
                    return response.json().then(function (body) {
                        if (!response.ok) { throw new Error(body && body.message ? body.message : ''); }
                        return body;
                    });
                })
                .then(function (data) { if (current === request) { render(data); } })
                .catch(function (error) {
                    if (current !== request) { return; }
                    var body = $('[data-ra-rows]');
                    body.textContent = '';
                    var cell = element('td', 'text-danger', error.message || i18n.failed);
                    cell.colSpan = columns;
                    body.appendChild(element('tr')).appendChild(cell);
                }));
        }

        box.querySelectorAll('[data-ra-page]').forEach(function (button) {
            button.addEventListener('click', function () { state.page += Number(button.dataset.raPage); load(); });
        });

        return { load: function () { state.page = 1; load(); } };
    }

    var cards = [
        card('broken', config.brokenLinksUrl, 4, function (row, data, compared) {
            var tr = element('tr');
            tr.appendChild(element('td', 'ra-gaps__path', row.path));
            tr.appendChild(countCell(row.hits, data.max));
            if (compared) { tr.appendChild(changeCell(row.hits, row.previous, 'down')); }
            tr.appendChild(element('td')).appendChild(whereList(row));
            return tr;
        }, i18n.noBroken, i18n.hiddenPages),
        card('search', config.searchesUrl, 3, function (row, data, compared) {
            var tr = element('tr');
            tr.appendChild(element('td', row.redacted ? 'ra-gaps__muted' : 'fw-semibold', row.redacted ? row.term + ' — ' + i18n.redacted : row.term));
            tr.appendChild(countCell(row.searches, data.max));
            if (compared) { tr.appendChild(changeCell(row.searches, row.previous, 'up')); }
            return tr;
        }, i18n.noSearches, i18n.hiddenTerms)
    ];

    function follow(next) { range = next; cards.forEach(function (one) { one.load(); }); }
    document.addEventListener('ra:range', function (event) { follow(event.detail); });
    var trend = document.getElementById('ra-trend');
    if (trend && trend.dataset.raRange) { follow(JSON.parse(trend.dataset.raRange)); }
})();
</script>
